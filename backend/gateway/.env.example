PORT=8000
NODE_ENV=development

REDIS_URL="redis://localhost:6379"

# Comma-separated list of origins allowed to call the API with cookies.
# In production this is your deployed frontend URL.
CORS_ORIGINS="http://localhost:5173"

AUTH_SERVICE="http://localhost:8001"
CHAT_SERVICE="http://localhost:8002"
AGENT_SERVICE="http://localhost:8003"
BILLING_SERVICE="http://localhost:8004"

# Shared secret proving a request came from the gateway. Must be identical in
# every service. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=generate-with-openssl-rand-hex-32

# Global rate limit: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS per user.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
