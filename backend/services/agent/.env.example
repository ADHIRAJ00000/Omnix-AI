PORT=8003
NODE_ENV=development

MONGODB_URL=add your mongodb url
REDIS_URL="redis://localhost:6379"

CHAT_SERVICE=http://localhost:8002
AUTH_SERVICE=http://localhost:8001
GATEWAY_URL=http://localhost:8000

# Must match the value in every other service. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=generate-with-openssl-rand-hex-32

# How many past messages are sent to the model as context.
MAX_MEMORY_MESSAGES=20

# --- Model providers (all have free tiers) ---
# Gemini, used for chat and embeddings: aistudio.google.com/apikey
GOOGLE_API_KEY=add your google api key
# Groq, fast and free: console.groq.com/keys
GROQ_API_KEY=add your groq api key
# Tavily, web search for the search agent, 1000 free searches/month
TAVILY_API_KEY=add your tavily api key
OPENROUTER_API_KEY=add open router api key

# --- File storage (needed by the pdf, ppt and image agents) ---
AWS_ACCESS_KEY_ID=add AWS ACCESS KEY ID
AWS_SECRET_ACCESS_KEY=Add AWS secret access key
AWS_REGION="ap-south-1"
AWS_BUCKET_NAME=add AWS bucket name

# --- Vector database (needed by the PDF RAG agent). Free tier at cloud.qdrant.io
QDRANT_URL=add qdrant url
QDRANT_API_KEY=add qdrant api key
