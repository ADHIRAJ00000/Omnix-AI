PORT=8001
NODE_ENV=development

MONGODB_URL=add your mongodb url
REDIS_URL="redis://localhost:6379"
FRONTEND_URL="http://localhost:5173"

# Must match the value in every other service. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=generate-with-openssl-rand-hex-32

# How long a login lasts, in seconds. Default is 7 days.
SESSION_TTL_SECONDS=604800

# Deployment only. Locally the file services/auth/serviceAccount.json is used
# instead. Paste the entire service account JSON as one line.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
