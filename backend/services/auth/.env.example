PORT=8001
NODE_ENV=development

MONGODB_URL=add your mongodb url
REDIS_URL="redis://localhost:6379"
FRONTEND_URL="http://localhost:5173"

# Must match the value in every other service. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=generate-with-openssl-rand-hex-32

# Signs access tokens. The gateway needs this exact same value to verify them.
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=generate-with-openssl-rand-hex-32

# How long an access token lasts before the client silently refreshes it.
ACCESS_TOKEN_TTL=15m

# How long a login lasts before a full sign-in is required again. 7 days.
REFRESH_TOKEN_TTL_SECONDS=604800

# Google sign-in only. Locally the file services/auth/serviceAccount.json is
# used instead. Paste the entire service account JSON as one line.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
