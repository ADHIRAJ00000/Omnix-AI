PORT=8004
NODE_ENV=development

MONGODB_URL=add your mongodb url
AUTH_SERVICE="http://localhost:8001"

# Razorpay test-mode keys are free: dashboard.razorpay.com -> Settings -> API Keys.
# Test mode gives real orders, real signatures and no real money.
RAZORPAY_KEY_ID=add razorpay key id
RAZORPAY_KEY_SECRET=add razorpay key secret

# Must match the value in every other service. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=generate-with-openssl-rand-hex-32
