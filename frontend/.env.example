# The gateway URL. Every API call goes through it.
VITE_SERVER_URL="http://localhost:8000"

# Google sign-in. All four come from Firebase console -> Project settings ->
# Your apps -> Web app -> SDK setup and configuration.
#
# Leave them blank to hide the Google button; email and password sign-in works
# without it. apiKey alone is not enough — the popup is served from authDomain
# and the ID token is issued against projectId, so a partial config gives you a
# popup that opens and then fails.
#
# The auth service also needs FIREBASE_SERVICE_ACCOUNT to verify the tokens
# these produce. Without it, sign-in fails at the backend instead.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Razorpay public key id (the key_id, not the secret — this one ships to the
# browser by design). Test mode keys are free.
VITE_RAZORPAY_KEY=
