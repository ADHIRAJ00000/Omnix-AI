# The gateway URL. Every API call goes through it.
VITE_SERVER_URL="http://localhost:8000"

# Google sign-in only. Leave blank to disable the Google button — email and
# password sign-in works without it.
# Get this from the Firebase console: Project settings -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=add your firebase api key

# Razorpay public key id (the key_id, not the secret — this one ships to the
# browser by design). Test mode keys are free.
VITE_RAZORPAY_KEY=add your razorpay key id
